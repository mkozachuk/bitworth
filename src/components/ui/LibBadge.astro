---
interface Props {
  label: string;
  version?: string;
}

const { label, version } = Astro.props;
---

<span
  class="bg-kraft/60 text-foreground/80 border-foreground/15 inline-flex items-center gap-2 rounded-sm border px-3 py-1.5 font-mono"
>
  {label}
  {
    version && (
      <span class="border-foreground/15 text-foreground/70 tnum rounded-sm border px-2 py-0.5 text-xs">{version}</span>
    )
  }
</span>
