---
import TopbarMenu from "@/components/TopbarMenu";
import InstallButton from "@/components/InstallButton";
import BrandSeal from "@/components/BrandSeal.astro";

const { user } = Astro.locals;
const path = Astro.url.pathname;

const navLinks = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/dashboard/assets", label: "Assets" },
  { href: "/dashboard/goals", label: "Goals" },
  { href: "/dashboard/balancer", label: "Balance" },
  { href: "/dashboard/fire", label: "FIRE" },
  { href: "/dashboard/forecast", label: "Forecast" },
  { href: "/dashboard/settings", label: "Settings" },
];

const isActive = (href: string) => (href === "/dashboard" ? path === "/dashboard" : path.startsWith(href));
---

<header
  class="border-primary/80 mb-6 flex items-center justify-between gap-3 border-b-2 px-4 py-3 pt-[max(env(safe-area-inset-top),0.75rem)] sm:px-6"
>
  <a href="/" class="flex min-w-0 items-center gap-2.5" aria-label="BitWorth home">
    <BrandSeal class="h-7 w-7 flex-none" />
    <span class="font-display text-foreground text-lg leading-none font-bold tracking-wide">BitWorth</span>
    {
      user && (
        <span class="text-muted-foreground mt-0.5 hidden max-w-[160px] truncate text-xs xl:inline">{user.email}</span>
      )
    }
  </a>
  {
    user ? (
      <nav class="flex items-center gap-4" aria-label="Main">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "hidden text-sm underline-offset-8 transition-colors sm:inline-flex",
              isActive(link.href)
                ? "text-primary dark:text-foreground font-medium underline decoration-2"
                : "text-foreground/70 hover:text-primary dark:hover:text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))}
        <InstallButton client:load />
        <form method="POST" action="/api/auth/signout" class="hidden sm:block">
          <button
            type="submit"
            class="text-foreground/70 hover:text-primary dark:hover:text-foreground text-sm underline-offset-8 transition-colors"
          >
            Sign out
          </button>
        </form>
        <div class="sm:hidden">
          <TopbarMenu user={{ email: user.email }} client:load />
        </div>
      </nav>
    ) : (
      <nav class="flex items-center gap-4" aria-label="Main">
        <a
          href="/auth/signin"
          class="text-foreground/70 hover:text-primary dark:hover:text-foreground text-sm underline-offset-8 transition-colors"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-sm px-4 py-1.5 text-sm font-medium transition-colors"
        >
          Sign up
        </a>
      </nav>
    )
  }
</header>
