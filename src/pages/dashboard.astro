---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { NetWorthDisplay } from "@/components/assets/NetWorthDisplay";
import type { Tables } from "@/lib/database.types";

type AssetWithCategory = Tables<"assets"> & { category: Tables<"asset_categories"> };
type Currency = "USD" | "EUR" | "PLN";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = "USD";

const { data: assets } = await supabase
  .from("assets")
  .select("*, category:asset_categories(*)")
  .eq("user_id", user.id);

const rates = await getRates(supabase);
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <Topbar />
    <div class="mx-auto max-w-3xl px-4 py-8">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>

      {
        assets && (
          <NetWorthDisplay
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
        )
      }

      <div class="mt-6 rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <p class="text-blue-100/60">
          Your assets will appear here.{" "}
          <a href="/dashboard/assets" class="text-purple-300 underline transition-colors hover:text-purple-100">
            Manage assets
          </a>
        </p>
      </div>

      <div class="mt-6 flex justify-end">
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white/80 transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>