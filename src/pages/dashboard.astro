---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { NetWorthDisplay } from "@/components/assets/NetWorthDisplay";
import { AssetsSummary } from "@/components/assets/AssetsSummary";
import { NetWorthChart } from "@/components/NetWorthChart";
import type { Tables } from "@/lib/database.types";

type AssetWithCategory = Tables<"assets"> & { category: Tables<"asset_categories"> };
type Currency = "USD" | "EUR" | "PLN";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = "USD";

const { data: assets } = await supabase.from("assets").select("*, category:asset_categories(*)").eq("user_id", user.id);

const rates = await getRates(supabase);

const { data: snapshots } = await supabase
  .from("snapshots")
  .select()
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });
---

<Layout title="Dashboard">
  <div class="bg-cosmic-light dark:bg-cosmic min-h-screen">
    <Topbar />
    <div class="mx-auto max-w-3xl px-4 py-8">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-3xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
      >
        Dashboard
      </h1>

      {
        assets && (
          <>
            <NetWorthDisplay
              assets={assets as AssetWithCategory[]}
              displayCurrency={displayCurrency}
              rates={rates}
              snapshots={snapshots as Tables<"snapshots">[]}
              onSnapshotSaved={() => {
                window.location.reload();
              }}
              client:load
            />
            <AssetsSummary
              assets={assets as AssetWithCategory[]}
              displayCurrency={displayCurrency}
              rates={rates}
              client:load
            />
            <NetWorthChart
              snapshots={snapshots as Tables<"snapshots">[]}
              displayCurrency={displayCurrency}
              onSaveSnapshot={() => {
                window.location.reload();
              }}
              client:load
            />
          </>
        )
      }

      <div
        class="mt-6 rounded-2xl border border-zinc-200 bg-white/80 p-8 text-center text-zinc-700 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white"
      >
        <p class="text-zinc-600 dark:text-blue-100/60">
          Your assets will appear here.{" "}
          <a
            href="/dashboard/assets"
            class="text-purple-600 underline transition-colors hover:text-purple-800 dark:text-purple-300 dark:hover:text-purple-100"
          >
            Manage assets
          </a>
        </p>
      </div>

      <div class="mt-6 flex justify-end">
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-zinc-300 bg-white/80 px-4 py-2 text-sm text-zinc-700 transition-colors hover:bg-white dark:border-white/20 dark:bg-white/10 dark:text-white/80 dark:hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
