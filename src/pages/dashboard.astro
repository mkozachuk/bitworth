---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { computeNetWorth } from "@/lib/net-worth";
import { computeFireProjection, monthsOfRunway, type FireInputs } from "@/lib/fire";
import { NetWorthDisplay } from "@/components/assets/NetWorthDisplay";
import { AssetsSummary } from "@/components/assets/AssetsSummary";
import { NetWorthChart } from "@/components/NetWorthChart";
import { ContributionsChart } from "@/components/ContributionsChart";
import { TopMovers } from "@/components/assets/TopMovers";
import { AssetTrendsChart, type SnapshotItemWithDate } from "@/components/AssetTrendsChart";
import { FireProgress } from "@/components/fire/FireProgress";
import type { Tables } from "@/lib/database.types";

type AssetWithCategory = Tables<"assets"> & { category: Tables<"asset_categories"> };
type SnapshotItemWithCategory = Tables<"snapshot_items"> & { category: Tables<"asset_categories"> };
type Currency = "USD" | "EUR" | "PLN";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = Astro.locals.displayCurrency ?? "USD";

const { data: assets } = await supabase.from("assets").select("*, category:asset_categories(*)").eq("user_id", user.id);

const rates = await getRates(supabase);

const { data: snapshots } = await supabase
  .from("snapshots")
  .select()
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });

// Latest snapshot is the last element (loaded ascending). Load its items as the
// baseline for the Top Movers diff; skip the query when there are no snapshots.
const snapshotRows = (snapshots ?? []) as Tables<"snapshots">[];
const latestSnapshot = snapshotRows.length > 0 ? snapshotRows[snapshotRows.length - 1] : null;
const { data: baselineItems } = latestSnapshot
  ? await supabase.from("snapshot_items").select("*, category:asset_categories(*)").eq("snapshot_id", latestSnapshot.id)
  : { data: null };
const hasSnapshot = (baselineItems?.length ?? 0) > 0;

// All-snapshot items (with category join) for the Asset Trends chart. One nested
// round trip scoped by the parent `user_id`; each item is flattened with its
// parent snapshot's `created_at` so the pure builder can order points in time.
const { data: snapshotsWithItems } = await supabase
  .from("snapshots")
  .select("id, created_at, snapshot_items(*, category:asset_categories(*))")
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });

interface SnapshotWithItems {
  created_at: string;
  snapshot_items: SnapshotItemWithCategory[];
}
const trendSnapshotItems: SnapshotItemWithDate[] = ((snapshotsWithItems ?? []) as SnapshotWithItems[]).flatMap(
  (snapshot) => snapshot.snapshot_items.map((item) => ({ ...item, snapshotDate: snapshot.created_at })),
);

// FIRE-progress card. The toggle (`show_fire_dashboard`, default TRUE) gates the
// whole card; when on, compute net worth + the projection server-side so the
// island stays purely presentational. Chained selects resolve to `any` in
// frontmatter, so read the numeric fire_* columns through a typed record at the
// boundary (same reason fire.astro casts its prefs row).
const { data: prefs } = await supabase
  .from("user_preferences")
  .select(
    "show_fire_dashboard, fire_current_age, fire_annual_income, fire_annual_expenses, fire_expected_return, fire_inflation_rate, fire_safe_withdrawal_rate, fire_starting_principal_override, fire_traditional_retirement_age, fire_barista_income",
  )
  .eq("user_id", user.id)
  .maybeSingle();

const showFireDashboard: boolean = (prefs?.show_fire_dashboard ?? true) as boolean;
const firePrefs = (prefs ?? {}) as Record<string, number | null>;

interface FireCardProps {
  configured: boolean;
  percent?: number;
  fireNumber?: number;
  yearsToFi?: number | null;
  runwayMonths?: number | null;
  displayCurrency: Currency;
}

let fireCard: FireCardProps | null = null;
if (showFireDashboard) {
  // Live net worth: numerator of the progress bar AND the default starting
  // principal for the projection (the override, when set, replaces the latter).
  const netWorth = computeNetWorth(
    ((assets ?? []) as AssetWithCategory[]).map((a) => ({
      amount: a.amount,
      currency: a.currency as Currency,
      category: { is_liability: a.category.is_liability },
    })),
    displayCurrency,
    rates,
  );

  // Pull the core columns into consts so the `configured` alias narrows them to
  // non-null inside the branch below (TS aliased-condition narrowing) — avoiding
  // both an `as number` cast and a `!` assertion, which the lint rules reject.
  const annualExpenses = firePrefs.fire_annual_expenses;
  const annualIncome = firePrefs.fire_annual_income;
  const expectedReturn = firePrefs.fire_expected_return;
  const inflationRate = firePrefs.fire_inflation_rate;
  const currentAge = firePrefs.fire_current_age;
  const swr = firePrefs.fire_safe_withdrawal_rate;

  // Configured = all core inputs present, SWR > 0, and expenses > 0. The SWR > 0
  // guard is required before computeFireProjection (it divides by SWR and throws
  // RangeError otherwise). The expenses > 0 guard mirrors monthsOfRunway: a
  // zero-expense profile makes fireNumber 0, so percent = netWorth / 0 would be
  // Infinity/NaN — treat it as not-yet-configured (show the placeholder).
  const configured =
    annualExpenses != null &&
    annualExpenses > 0 &&
    annualIncome != null &&
    expectedReturn != null &&
    inflationRate != null &&
    currentAge != null &&
    swr != null &&
    swr > 0;

  if (configured) {
    const inputs: FireInputs = {
      startingPrincipal: firePrefs.fire_starting_principal_override ?? netWorth,
      annualIncome,
      annualExpenses,
      nominalReturn: expectedReturn,
      inflationRate,
      safeWithdrawalRate: swr,
      currentAge,
      traditionalRetirementAge: firePrefs.fire_traditional_retirement_age ?? 65,
      baristaIncome: firePrefs.fire_barista_income ?? undefined,
    };
    const result = computeFireProjection(inputs);
    fireCard = {
      configured: true,
      percent: (netWorth / result.fireNumber) * 100,
      fireNumber: result.fireNumber,
      yearsToFi: result.yearsToFi,
      runwayMonths: monthsOfRunway(netWorth, annualExpenses),
      displayCurrency,
    };
  } else {
    fireCard = { configured: false, displayCurrency };
  }
}
---

<Layout title="Dashboard">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <h1
      class="mb-6 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-3xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
    >
      Dashboard
    </h1>

    {
      assets && (
        <>
          <NetWorthDisplay
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            snapshots={snapshots as Tables<"snapshots">[]}
            onSnapshotSaved={() => {
              window.location.reload();
            }}
            client:load
          />
          {fireCard && <FireProgress {...fireCard} client:load />}
          <AssetsSummary
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
          <NetWorthChart
            snapshots={snapshots as Tables<"snapshots">[]}
            displayCurrency={displayCurrency}
            onSaveSnapshot={() => {
              window.location.reload();
            }}
            client:load
          />
          <ContributionsChart
            snapshots={snapshots as Tables<"snapshots">[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
          <AssetTrendsChart
            assets={assets as AssetWithCategory[]}
            snapshots={snapshots as Tables<"snapshots">[]}
            snapshotItems={trendSnapshotItems}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
        </>
      )
    }

    <TopMovers
      assets={(assets ?? []) as AssetWithCategory[]}
      baselineItems={(baselineItems ?? []) as SnapshotItemWithCategory[]}
      hasSnapshot={hasSnapshot}
      displayCurrency={displayCurrency}
      rates={rates}
      client:load
    />
  </div>
</Layout>
