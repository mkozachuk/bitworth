---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { computeNetWorth } from "@/lib/net-worth";
import { computeFireProjection, monthsOfRunway, type FireInputs } from "@/lib/fire";
import { NetWorthDisplay } from "@/components/assets/NetWorthDisplay";
import { AssetsSummary } from "@/components/assets/AssetsSummary";
import { NetWorthChart } from "@/components/NetWorthChart";
import { ContributionsChart } from "@/components/ContributionsChart";
import { TopMovers } from "@/components/assets/TopMovers";
import { AssetTrendsChart, type SnapshotItemWithDate } from "@/components/AssetTrendsChart";
import { FireProgress } from "@/components/fire/FireProgress";
import { computeDrift, type AllocationAsset, type DriftCardInput } from "@/lib/allocation";
import { DriftAlerts, type DriftAlertsProps } from "@/components/balancer/DriftAlerts";
import { convertAmount } from "@/lib/net-worth";
import { fitLinear, type Fit, type TrajectorySample } from "@/lib/trajectory";
import { goalCurrentValue, goalEta, goalProgressPct, onTrackVerdict, type GoalAsset } from "@/lib/goals";
import { GoalsProgress, type GoalProgressItem, type GoalsProgressProps } from "@/components/goals/GoalsProgress";
import type { Tables } from "@/lib/database.types";

type AssetWithCategory = Tables<"assets"> & { category: Tables<"asset_categories"> };
type SnapshotItemWithCategory = Tables<"snapshot_items"> & { category: Tables<"asset_categories"> };
type Currency = "USD" | "EUR" | "PLN";

/** The trajectory sample axis is days; mirrors NetWorthChart.tsx:20. */
const MS_PER_DAY = 86_400_000;

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = Astro.locals.displayCurrency ?? "USD";

const { data: assets } = await supabase.from("assets").select("*, category:asset_categories(*)").eq("user_id", user.id);

const rates = await getRates(supabase);

const { data: snapshots } = await supabase
  .from("snapshots")
  .select()
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });

// Latest snapshot is the last element (loaded ascending). Load its items as the
// baseline for the Top Movers diff; skip the query when there are no snapshots.
const snapshotRows = (snapshots ?? []) as Tables<"snapshots">[];
const latestSnapshot = snapshotRows.length > 0 ? snapshotRows[snapshotRows.length - 1] : null;
const { data: baselineItems } = latestSnapshot
  ? await supabase.from("snapshot_items").select("*, category:asset_categories(*)").eq("snapshot_id", latestSnapshot.id)
  : { data: null };
const hasSnapshot = (baselineItems?.length ?? 0) > 0;

// All-snapshot items (with category join) for the Asset Trends chart. One nested
// round trip scoped by the parent `user_id`; each item is flattened with its
// parent snapshot's `created_at` so the pure builder can order points in time.
const { data: snapshotsWithItems } = await supabase
  .from("snapshots")
  .select("id, created_at, snapshot_items(*, category:asset_categories(*))")
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });

interface SnapshotWithItems {
  created_at: string;
  snapshot_items: SnapshotItemWithCategory[];
}
const trendSnapshotItems: SnapshotItemWithDate[] = ((snapshotsWithItems ?? []) as SnapshotWithItems[]).flatMap(
  (snapshot) => snapshot.snapshot_items.map((item) => ({ ...item, snapshotDate: snapshot.created_at })),
);

// FIRE-progress card. The toggle (`show_fire_dashboard`, default TRUE) gates the
// whole card; when on, compute net worth + the projection server-side so the
// island stays purely presentational. Chained selects resolve to `any` in
// frontmatter, so read the numeric fire_* columns through a typed record at the
// boundary (same reason fire.astro casts its prefs row).
const { data: prefs } = await supabase
  .from("user_preferences")
  .select(
    "show_fire_dashboard, show_drift_alerts, show_trajectory, show_goals, fire_current_age, fire_annual_income, fire_annual_expenses, fire_expected_return, fire_inflation_rate, fire_safe_withdrawal_rate, fire_starting_principal_override, fire_traditional_retirement_age, fire_barista_income",
  )
  .eq("user_id", user.id)
  .maybeSingle();

const showFireDashboard: boolean = (prefs?.show_fire_dashboard ?? true) as boolean;
const showTrajectory: boolean = (prefs?.show_trajectory ?? true) as boolean;
const showGoals: boolean = (prefs?.show_goals ?? true) as boolean;
const firePrefs = (prefs ?? {}) as Record<string, number | null>;

interface FireCardProps {
  configured: boolean;
  percent?: number;
  fireNumber?: number;
  yearsToFi?: number | null;
  runwayMonths?: number | null;
  displayCurrency: Currency;
}

let fireCard: FireCardProps | null = null;
if (showFireDashboard) {
  // Live net worth: numerator of the progress bar AND the default starting
  // principal for the projection (the override, when set, replaces the latter).
  const netWorth = computeNetWorth(
    ((assets ?? []) as AssetWithCategory[]).map((a) => ({
      amount: a.amount,
      currency: a.currency as Currency,
      category: { is_liability: a.category.is_liability },
    })),
    displayCurrency,
    rates,
  );

  // Pull the core columns into consts so the `configured` alias narrows them to
  // non-null inside the branch below (TS aliased-condition narrowing) — avoiding
  // both an `as number` cast and a `!` assertion, which the lint rules reject.
  const annualExpenses = firePrefs.fire_annual_expenses;
  const annualIncome = firePrefs.fire_annual_income;
  const expectedReturn = firePrefs.fire_expected_return;
  const inflationRate = firePrefs.fire_inflation_rate;
  const currentAge = firePrefs.fire_current_age;
  const swr = firePrefs.fire_safe_withdrawal_rate;

  // Configured = all core inputs present, SWR > 0, and expenses > 0. The SWR > 0
  // guard is required before computeFireProjection (it divides by SWR and throws
  // RangeError otherwise). The expenses > 0 guard mirrors monthsOfRunway: a
  // zero-expense profile makes fireNumber 0, so percent = netWorth / 0 would be
  // Infinity/NaN — treat it as not-yet-configured (show the placeholder).
  const configured =
    annualExpenses != null &&
    annualExpenses > 0 &&
    annualIncome != null &&
    expectedReturn != null &&
    inflationRate != null &&
    currentAge != null &&
    swr != null &&
    swr > 0;

  if (configured) {
    const inputs: FireInputs = {
      startingPrincipal: firePrefs.fire_starting_principal_override ?? netWorth,
      annualIncome,
      annualExpenses,
      nominalReturn: expectedReturn,
      inflationRate,
      safeWithdrawalRate: swr,
      currentAge,
      traditionalRetirementAge: firePrefs.fire_traditional_retirement_age ?? 65,
      baristaIncome: firePrefs.fire_barista_income ?? undefined,
    };
    const result = computeFireProjection(inputs);
    fireCard = {
      configured: true,
      percent: (netWorth / result.fireNumber) * 100,
      fireNumber: result.fireNumber,
      yearsToFi: result.yearsToFi,
      runwayMonths: monthsOfRunway(netWorth, annualExpenses),
      displayCurrency,
    };
  } else {
    fireCard = { configured: false, displayCurrency };
  }
}

// Savings-goals card. Gated by `show_goals` (default TRUE). All the math is
// server-side (src/lib/goals.ts) so the island stays a function of props. Unlike
// `driftAlerts`, `goalsCard` stays non-null when the user has no goals — that is
// what renders the placeholder, because Goals is a persistent status widget and
// not an alert.
let goalsCard: GoalsProgressProps | null = null;
if (showGoals) {
  // Same projection as GOAL_SELECT in src/pages/api/goals/index.ts, minus the
  // columns the card does not read; `user_id` is deliberately absent.
  const { data: goalRows } = await supabase
    .from("goals")
    .select("id, name, kind, category_id, target_amount, target_currency, target_date")
    .eq("user_id", user.id)
    .order("created_at", { ascending: true });

  // Chained selects resolve to `any` in frontmatter (same boundary as the prefs
  // cast above), so narrow once here.
  interface GoalCardRow {
    id: string;
    name: string;
    kind: string;
    category_id: string | null;
    target_amount: number;
    target_currency: string;
    target_date: string | null;
  }
  const goalList = (goalRows ?? []) as GoalCardRow[];

  const assetRows = (assets ?? []) as AssetWithCategory[];
  const goalAssets: GoalAsset[] = assetRows.map((a) => ({
    category_id: a.category_id,
    amount: a.amount,
    currency: a.currency,
  }));

  // The net-worth goals' numerator. Computed here rather than reusing the FIRE
  // block's local so the two cards stay independently gated.
  const goalsNetWorth = computeNetWorth(
    assetRows.map((a) => ({
      amount: a.amount,
      currency: a.currency as Currency,
      category: { is_liability: a.category.is_liability },
    })),
    displayCurrency,
    rates,
  );

  // ONE fit for every goal, over the already-fetched snapshots. Filter to the
  // comparable (same display currency) rows FIRST so the trend never spans a
  // currency change — mirrors NetWorthChart.tsx:128-182. Fewer than 2 comparable
  // rows is `insufficient_history`, which goalEta decides, not this block.
  const comparable = ((snapshots ?? []) as Tables<"snapshots">[]).filter((s) => s.display_currency === displayCurrency);
  const originMs = comparable.length > 0 ? new Date(comparable[0].created_at).getTime() : 0;
  const samples: TrajectorySample[] = comparable.map((s) => ({
    t: (new Date(s.created_at).getTime() - originMs) / MS_PER_DAY,
    value: s.total_net_worth,
  }));
  const goalsFit: Fit | null = samples.length >= 2 ? fitLinear(samples) : null;
  const goalsLastT = samples.length > 0 ? samples[samples.length - 1].t : 0;

  const goalItems: GoalProgressItem[] = goalList.map((goal) => {
    // The SAME converted target feeds the progress denominator and the ETA, so
    // the two can never silently disagree.
    const targetInDisplayCurrency = convertAmount(
      goal.target_amount,
      goal.target_currency as Currency,
      displayCurrency,
      rates,
    );
    const current = goalCurrentValue(goal, goalAssets, goalsNetWorth, displayCurrency, rates);
    const percent = goalProgressPct(current, targetInDisplayCurrency);
    const eta = goalEta(
      { kind: goal.kind, targetInDisplayCurrency },
      goalsFit,
      goalsLastT,
      originMs,
      percent,
      comparable.length,
    );
    return {
      id: goal.id,
      name: goal.name,
      percent,
      current,
      target: targetInDisplayCurrency,
      eta,
      verdict: onTrackVerdict(eta, goal.target_date),
    };
  });

  goalsCard = { goals: goalItems, displayCurrency };
}

// Allocation-drift card. Gated by `show_drift_alerts` (default TRUE). When on,
// load the user's balancer cards + their nested targets (same query the balancer
// page uses), reshape each into computeDrift's input by joining targets to the
// non-liability assets already loaded above, and compute drift server-side so the
// island stays presentational. The props object is built only when a card is
// actually breaching the threshold — otherwise the card renders nothing.
const showDriftAlerts: boolean = (prefs?.show_drift_alerts ?? true) as boolean;

let driftAlerts: DriftAlertsProps | null = null;
if (showDriftAlerts) {
  const { data: driftCardRows } = await supabase
    .from("allocation_cards")
    .select("id, name, allocation_targets(asset_id, target_pct)")
    .eq("user_id", user.id)
    .order("position", { ascending: true })
    .order("created_at", { ascending: true });

  // Non-liability assets keyed by id, so each card's targets can be joined back to
  // a raw amount + currency for computeDrift (mirrors balancer.astro's asset set).
  const nonLiabilityById = new Map(
    ((assets ?? []) as AssetWithCategory[]).filter((a) => !a.category.is_liability).map((a) => [a.id, a] as const),
  );

  // The chained select resolves to `any` in frontmatter (same boundary as the
  // prefs/balancer casts), so read the rows through a typed shape before reshaping.
  interface RawDriftCard {
    id: string;
    name: string;
    allocation_targets: { asset_id: string; target_pct: number }[];
  }
  const driftCards: DriftCardInput[] = ((driftCardRows ?? []) as RawDriftCard[]).map((card) => ({
    id: card.id,
    name: card.name,
    // A target whose asset was deleted (or is a liability) drops out — it has no
    // current value to weigh, so it cannot contribute drift.
    assets: card.allocation_targets
      .map((t): AllocationAsset | null => {
        const asset = nonLiabilityById.get(t.asset_id);
        if (!asset) return null;
        return {
          asset_id: asset.id,
          name: asset.name,
          amount: asset.amount,
          currency: asset.currency,
          targetPct: t.target_pct,
        };
      })
      .filter((a): a is AllocationAsset => a !== null),
  }));

  const drift = computeDrift(driftCards, displayCurrency, rates);
  if (drift.worst) {
    driftAlerts = {
      worstName: drift.worst.name,
      declaredSum: drift.worst.declaredSum,
      offenders: drift.worst.offenders.map((o) => ({
        asset_id: o.asset_id,
        name: o.name,
        drift: o.drift,
        realPct: o.realPct,
        normalizedTargetPct: o.normalizedTargetPct,
      })),
      otherBreachingNames: drift.otherBreachingNames,
      threshold: drift.threshold,
      displayCurrency,
    };
  }
}
---

<Layout title="Dashboard">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <h1
      class="mb-6 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-3xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
    >
      Dashboard
    </h1>

    {
      assets && (
        <>
          <NetWorthDisplay
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            snapshots={snapshots as Tables<"snapshots">[]}
            onSnapshotSaved={() => {
              window.location.reload();
            }}
            client:load
          />
          {fireCard && <FireProgress {...fireCard} client:load />}
          {goalsCard && <GoalsProgress {...goalsCard} client:load />}
          {driftAlerts && <DriftAlerts {...driftAlerts} client:load />}
          <AssetsSummary
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
          <NetWorthChart
            snapshots={snapshots as Tables<"snapshots">[]}
            displayCurrency={displayCurrency}
            showTrajectory={showTrajectory}
            onSaveSnapshot={() => {
              window.location.reload();
            }}
            client:load
          />
          <ContributionsChart
            snapshots={snapshots as Tables<"snapshots">[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
          <AssetTrendsChart
            assets={assets as AssetWithCategory[]}
            snapshots={snapshots as Tables<"snapshots">[]}
            snapshotItems={trendSnapshotItems}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
        </>
      )
    }

    <TopMovers
      assets={(assets ?? []) as AssetWithCategory[]}
      baselineItems={(baselineItems ?? []) as SnapshotItemWithCategory[]}
      hasSnapshot={hasSnapshot}
      displayCurrency={displayCurrency}
      rates={rates}
      client:load
    />
  </div>
</Layout>
