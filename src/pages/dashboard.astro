---
import Layout from "@/layouts/Layout.astro";
import { DashboardClient } from "@/components/dashboard/DashboardClient";
import { ErrorBoundary } from "@/components/dashboard/ErrorBoundary";
import { createDbClient } from "@/lib/db";
import type { Currency } from "@/lib/net-worth";

const db = createDbClient(Astro.request.headers, Astro.cookies);
if (!db) {
  return new Response("Database unavailable", { status: 500 });
}

const { user } = Astro.locals;
if (!user) {
  return Astro.redirect("/auth/signin", 302);
}

// SSR-fetch all required data
const [profileResult, assetsResult, snapshotsResult, ratesResult] = await Promise.all([
  db.from("profiles").select("*").eq("id", user.id).single(),
  db.from("assets").select("*").eq("user_id", user.id).order("created_at", { ascending: false }),
  db.from("snapshots").select("*").eq("user_id", user.id).order("snapshot_date", { ascending: true }),
  db.from("exchange_rates").select("*").order("fetched_at", { ascending: false }).limit(10),
]);

const profile = profileResult.data;
const assets = assetsResult.data ?? [];
const snapshots = snapshotsResult.data ?? [];
const rates = ratesResult.data ?? [];

const displayCurrency = (profile?.display_currency ?? "PLN") as Currency;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <ErrorBoundary client:load>
      <DashboardClient
        client:load
        profile={{ display_currency: displayCurrency }}
        assets={assets}
        snapshots={snapshots}
        rates={rates}
      />
    </ErrorBoundary>
  </div>
</Layout>
