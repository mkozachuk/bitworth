---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="bg-card border-border text-foreground w-full max-w-sm rounded-md border p-6 sm:p-8">
      <h1 class="font-display text-foreground mb-6 text-center text-2xl font-bold">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-foreground/70 mt-4 text-center text-sm">
        Already have an account? <a href="/auth/signin" class="text-primary dark:text-foreground hover:underline"
          >Sign in</a
        >
      </p>
    </div>
  </div>
</Layout>
