---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="bg-card border-border text-foreground w-full max-w-sm rounded-md border p-6 sm:p-8">
      <h1 class="font-display text-foreground mb-6 text-center text-2xl font-bold">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="text-foreground/70 mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary dark:text-foreground hover:underline"
          >Sign up</a
        >
      </p>
    </div>
  </div>
</Layout>
