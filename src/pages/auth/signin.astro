---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-cosmic-light dark:bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-zinc-200 bg-white/80 p-8 text-zinc-900 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white"
    >
      <h1
        class="mb-6 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-center text-2xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
      >
        Sign in
      </h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-zinc-600 dark:text-blue-100/60">
        Don't have an account? <a href="/auth/signup" class="text-purple-600 hover:underline dark:text-purple-300"
          >Sign up</a
        >
      </p>
    </div>
  </div>
</Layout>
