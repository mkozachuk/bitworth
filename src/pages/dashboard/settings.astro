---
import Layout from "@/layouts/DashboardLayout.astro";
import { SettingsForm } from "@/components/settings/SettingsForm";
import { BackupRestore } from "@/components/settings/BackupRestore";
import { createClient } from "@/lib/supabase";

type Currency = "USD" | "EUR" | "PLN";
type Theme = "light" | "dark" | "system";

const VALID_CURRENCIES: Currency[] = ["USD", "EUR", "PLN"];
const VALID_THEMES: Theme[] = ["light", "dark", "system"];

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

const { data: prefs } = await supabase
  .from("user_preferences")
  .select("display_currency, theme, show_fire_dashboard, show_drift_alerts, show_trajectory, show_goals")
  .eq("user_id", user.id)
  .maybeSingle();

const rawCurrency = (prefs as { display_currency?: string } | null)?.display_currency;
const rawTheme = (prefs as { theme?: string } | null)?.theme;
const rawShowFireDashboard = (prefs as { show_fire_dashboard?: boolean } | null)?.show_fire_dashboard;
const rawShowDriftAlerts = (prefs as { show_drift_alerts?: boolean } | null)?.show_drift_alerts;
const rawShowTrajectory = (prefs as { show_trajectory?: boolean } | null)?.show_trajectory;
const rawShowGoals = (prefs as { show_goals?: boolean } | null)?.show_goals;

const initialDisplayCurrency: Currency = VALID_CURRENCIES.includes(rawCurrency as Currency)
  ? (rawCurrency as Currency)
  : "USD";
const initialTheme: Theme = VALID_THEMES.includes(rawTheme as Theme) ? (rawTheme as Theme) : "system";
const initialShowFireDashboard: boolean = rawShowFireDashboard ?? true;
const initialShowDriftAlerts: boolean = rawShowDriftAlerts ?? true;
const initialShowTrajectory: boolean = rawShowTrajectory ?? true;
const initialShowGoals: boolean = rawShowGoals ?? true;
---

<Layout title="Settings">
  <div class="mx-auto max-w-2xl px-4 py-8">
    <h1 class="font-display text-foreground mb-6 text-3xl font-bold">Settings</h1>

    <div class="bg-card border-border rounded-md border p-8">
      <SettingsForm
        initialDisplayCurrency={initialDisplayCurrency}
        initialTheme={initialTheme}
        initialShowFireDashboard={initialShowFireDashboard}
        initialShowDriftAlerts={initialShowDriftAlerts}
        initialShowTrajectory={initialShowTrajectory}
        initialShowGoals={initialShowGoals}
        client:load
      />
    </div>

    <h2 class="font-display text-foreground mt-8 mb-4 text-xl font-bold">Backup &amp; Restore</h2>

    <div class="bg-card border-border rounded-md border p-8">
      <BackupRestore client:load />
    </div>
  </div>
</Layout>
