---
import Layout from "@/layouts/DashboardLayout.astro";
import { AssetForm } from "@/components/assets/AssetForm";
import { createClient } from "@/lib/supabase";
import { compareTagNames, type TagChip } from "@/lib/tags";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: tagRows } = await supabase.from("tags").select("id, name").eq("user_id", user.id);
const tags = ((tagRows ?? []) as TagChip[]).sort(compareTagNames);
---

<Layout title="Add Asset">
  <div class="mx-auto max-w-lg px-4 py-8">
    <div class="mb-6">
      <a href="/dashboard/assets" class="text-primary dark:text-foreground text-sm transition-colors hover:underline">
        &larr; Back to Assets
      </a>
    </div>

    <div class="bg-card border-border rounded-md border p-8">
      <h1 class="font-display text-foreground mb-6 text-2xl font-bold">Add Asset</h1>
      <AssetForm mode="create" tags={tags} client:load />
    </div>
  </div>
</Layout>
