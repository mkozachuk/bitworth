---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { AssetList } from "@/components/assets/AssetList";
import { NetWorthDisplay } from "@/components/assets/NetWorthDisplay";
import type { Tables } from "@/lib/database.types";

type AssetWithCategory = Tables<"assets"> & { category: Tables<"asset_categories"> };
type Currency = "USD" | "EUR" | "PLN";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = Astro.locals.displayCurrency ?? "USD";

const { data: assets } = await supabase
  .from("assets")
  .select("*, category:asset_categories(*)")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false });

const rates = await getRates(supabase);
---

<Layout title="Assets">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="font-display text-foreground text-3xl font-bold">Assets</h1>
      <a
        href="/dashboard/assets/new"
        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-sm px-4 py-2 text-sm font-medium transition-colors"
      >
        + Add Asset
      </a>
    </div>

    {
      assets && (
        <>
          <NetWorthDisplay
            assets={assets as AssetWithCategory[]}
            displayCurrency={displayCurrency}
            rates={rates}
            client:load
          />
          <div class="bg-card border-border mt-6 rounded-md border p-6">
            <AssetList
              assets={assets as AssetWithCategory[]}
              displayCurrency={displayCurrency}
              rates={rates}
              client:load
            />
          </div>
        </>
      )
    }
  </div>
</Layout>
