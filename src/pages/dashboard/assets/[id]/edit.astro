---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { AssetForm } from "@/components/assets/AssetForm";
import type { Tables } from "@/lib/database.types";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

const { data: asset } = (await supabase
  .from("assets")
  .select("*, category:asset_categories(*)")
  .eq("id", id)
  .eq("user_id", user.id)
  .single()) as { data: Tables<"assets"> | null; error: unknown };

if (!asset) {
  return new Response(null, { status: 404 });
}
---

<Layout title="Edit Asset">
  <div class="mx-auto max-w-lg px-4 py-8">
    <div class="mb-6">
      <a href="/dashboard/assets" class="text-primary dark:text-foreground text-sm transition-colors hover:underline">
        &larr; Back to Assets
      </a>
    </div>

    <div class="bg-card border-border rounded-md border p-8">
      <h1 class="font-display text-foreground mb-6 text-2xl font-bold">Edit Asset</h1>
      <AssetForm
        asset={asset}
        mode="edit"
        onCancel={() => {
          window.history.back();
        }}
        client:load
      />
    </div>
  </div>
</Layout>
