---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { AssetForm } from "@/components/assets/AssetForm";
import type { Tables } from "@/lib/database.types";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

const { data: asset } = (await supabase
  .from("assets")
  .select("*, category:asset_categories(*)")
  .eq("id", id)
  .eq("user_id", user.id)
  .single()) as { data: Tables<"assets"> | null; error: unknown };

if (!asset) {
  return new Response(null, { status: 404 });
}
---

<Layout title="Edit Asset">
  <div class="mx-auto max-w-lg px-4 py-8">
    <div class="mb-6">
      <a
        href="/dashboard/assets"
        class="text-sm text-purple-600 transition-colors hover:text-purple-800 hover:underline dark:text-purple-300 dark:hover:text-purple-100"
      >
        &larr; Back to Assets
      </a>
    </div>

    <div
      class="rounded-2xl border border-zinc-200 bg-white/80 p-8 text-zinc-900 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white"
    >
      <h1
        class="mb-6 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-2xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
      >
        Edit Asset
      </h1>
      <AssetForm
        asset={asset}
        mode="edit"
        onCancel={() => {
          window.history.back();
        }}
        client:load
      />
    </div>
  </div>
</Layout>
