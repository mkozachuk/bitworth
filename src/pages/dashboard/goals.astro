---
import Layout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { getRates } from "@/lib/exchange-rates";
import { type Currency } from "@/lib/net-worth";
import { GoalsManager, type GoalCategory, type GoalRow } from "@/components/goals/GoalsManager";

// `/dashboard/goals` needs no middleware registration — PROTECTED_ROUTES is
// ["/dashboard"] and matches by startsWith (src/middleware.ts:4,35-39). The
// guard below is the same belt every dashboard page carries anyway.
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const displayCurrency: Currency = Astro.locals.displayCurrency ?? "USD";

// Same projection as GOAL_SELECT in src/pages/api/goals/index.ts: `user_id` is
// deliberately absent so the island never receives the tenant key.
const { data: goalRows } = await supabase
  .from("goals")
  .select("id, name, kind, category_id, target_amount, target_currency, target_date, created_at, updated_at")
  .eq("user_id", user.id)
  .order("created_at", { ascending: true });

// asset_categories is globally seeded and immutable, so the picker list is
// fetched here rather than by the island (assets' CategorySelect still does a
// client fetch; this page does not need one).
const { data: categoryRows } = await supabase
  .from("asset_categories")
  .select("id, name, icon")
  .order("display_order", { ascending: true });

const rates = await getRates(supabase);

// Chained Supabase selects resolve to `any` in .astro frontmatter (the same
// boundary balancer.astro and fire.astro cast through), so narrow once here.
const goals = (goalRows ?? []) as GoalRow[];
const categories = (categoryRows ?? []) as GoalCategory[];
---

<Layout title="Goals">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <h1
      class="mb-2 bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-3xl font-bold text-transparent dark:from-blue-200 dark:to-purple-200"
    >
      Savings Goals
    </h1>
    <p class="mb-6 text-sm text-zinc-600 dark:text-blue-100/60">
      Track a named target against your total net worth or a single asset category. Progress appears on your dashboard.
      Values are shown in {displayCurrency}.
    </p>

    <div
      class="rounded-2xl border border-zinc-200 bg-white/80 p-6 text-zinc-900 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white"
    >
      <GoalsManager goals={goals} categories={categories} displayCurrency={displayCurrency} rates={rates} client:load />
    </div>
  </div>
</Layout>
